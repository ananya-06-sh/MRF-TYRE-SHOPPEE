generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TyreCategory {
  TWO_WHEELER
  PASSENGER_CAR
  COMMERCIAL
}

model InventoryItem {
  id                     String       @id @default(uuid()) @db.Uuid
  productId              String       @unique
  billingMatchKey        String       @unique
  patternAndSize         String
  normalizedSize         String
  category               TyreCategory
  compatibleVehicles     String[]     @default([])
  currentStock           Int          @default(0)
  lowStockTrigger        Int          @default(4)
  baseCostPaise          Int
  gstRateBasisPoints     Int          @default(2800)
  finalSellingPricePaise Int
  isActive               Boolean      @default(true)
  version                Int          @default(1)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([normalizedSize])
  @@index([category])
  @@index([currentStock])
}