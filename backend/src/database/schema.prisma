generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TyreCategory {
  TWO_WHEELER
  PASSENGER_CAR
  COMMERCIAL
}

enum UserRole {
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum StockMovementType {
  OPENING_STOCK
  STOCK_IN
  SALE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  ADJUSTMENT
}

enum OrderStatus {
  CONFIRMED
  TALLY_SYNCED
  CANCELLED
}

enum ServiceType {
  ALIGNMENT
  BALANCING
  BOTH
}

enum ServiceJobStatus {
  IN_PROGRESS
  COMPLETED
}

model InventoryItem {
  id                     String          @id @default(uuid()) @db.Uuid
  productId              String          @unique
  billingMatchKey        String          @unique
  patternAndSize         String
  normalizedSize         String
  category               TyreCategory
  compatibleVehicles     String[]        @default([])
  currentStock           Int             @default(0)
  lowStockTrigger        Int             @default(4)
  baseCostPaise          Int
  gstRateBasisPoints     Int             @default(2800)
  finalSellingPricePaise Int
  isActive               Boolean         @default(true)
  version                Int             @default(1)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  stockMovements         StockMovement[]
  orderItems             OrderItem[]

  @@index([normalizedSize])
  @@index([category])
  @@index([currentStock])
}

model User {
  id                 String          @id @default(uuid()) @db.Uuid
  displayName        String
  loginIdentifier    String          @unique
  passwordHash       String
  role               UserRole
  status             UserStatus      @default(ACTIVE)
  canStockIn         Boolean         @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  stockMovements     StockMovement[]
  orders             Order[]
  serviceJobsCreated ServiceJob[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  inventoryItemId String            @db.Uuid
  performedById   String            @db.Uuid
  orderId         String?           @db.Uuid
  type            StockMovementType
  quantityChange  Int
  stockBefore     Int
  stockAfter      Int
  unitCostPaise   Int?
  supplierName    String?
  referenceNumber String?
  note            String?
  occurredAt      DateTime          @default(now())
  createdAt       DateTime          @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  performedBy   User          @relation(fields: [performedById], references: [id], onDelete: Restrict)
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, occurredAt])
  @@index([performedById])
  @@index([orderId])
  @@index([type])
}

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  billNumber         String      @unique
  idempotencyKey     String      @unique
  createdById        String      @db.Uuid
  status             OrderStatus @default(CONFIRMED)
  customerName       String?
  customerMobile     String?
  vehiclePlateNumber String?
  vehicleModel       String?
  productsTotalPaise Int
  serviceTotalPaise  Int
  includedTaxPaise   Int
  grandTotalPaise    Int
  tallyVoucherId     String?
  tallySyncedAt      DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  createdBy      User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items          OrderItem[]
  services       OrderServiceLine[]
  stockMovements StockMovement[]
  serviceJob     ServiceJob?

  @@index([createdById, createdAt])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                      String   @id @default(uuid()) @db.Uuid
  orderId                 String   @db.Uuid
  inventoryItemId         String   @db.Uuid
  productIdSnapshot       String
  billingMatchKeySnapshot String
  productNameSnapshot     String
  quantity                Int
  standardUnitPricePaise  Int
  billedUnitPricePaise    Int
  gstRateBasisPoints      Int
  includedTaxPaise        Int
  lineTotalPaise          Int
  baseCostPaiseSnapshot   Int
  createdAt               DateTime @default(now())

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([orderId, inventoryItemId])
  @@index([inventoryItemId])
}

model OrderServiceLine {
  id                     String   @id @default(uuid()) @db.Uuid
  orderId                String   @db.Uuid
  serviceIdSnapshot      String
  serviceNameSnapshot    String
  quantity               Int
  standardUnitPricePaise Int
  billedUnitPricePaise   Int
  gstRateBasisPoints     Int
  includedTaxPaise       Int
  lineTotalPaise         Int
  createdAt              DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model ServiceJob {
  id                 String           @id @default(uuid()) @db.Uuid
  jobNumber          String           @unique
  orderId            String?          @unique @db.Uuid
  createdById        String           @db.Uuid
  vehiclePlateNumber String
  vehicleModel       String
  serviceType        ServiceType
  assignedTechnician String?
  status             ServiceJobStatus @default(IN_PROGRESS)
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  order     Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@index([vehiclePlateNumber])
}
