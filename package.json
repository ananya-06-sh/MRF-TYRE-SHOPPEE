{
  "name": "mrf-tyre-shoppee",
  "version": "1.0.0",
  "description": "Mobile-first inventory, billing, service management, and TallyPrime integration application.",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "tally-connector"
  ],
  "scripts": {
    "dev": "concurrently --names BACKEND,FRONTEND --prefix-colors blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace=@mrf-shop/backend",
    "dev:frontend": "npm run dev --workspace=@mrf-shop/frontend",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  }
}